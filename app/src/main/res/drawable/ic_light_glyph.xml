<!--
    White-only, transparent-background version of ic_light.xml's bike-headlight glyph (housing + lens hole +
    3 beam rays), for places a filled background square would look wrong: the extension icon, the data-field
    icons (extension_info.xml) and the in-ride low-battery alert icon (IgpsExtension.kt), which already sits
    on its own coloured alert background.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp" android:height="24dp"
    android:viewportWidth="24" android:viewportHeight="24">
    <!-- Lamp housing, with the lens punched out as a hole (evenOdd) -->
    <path android:fillColor="#FFFFFFFF" android:fillType="evenOdd"
        android:pathData="M6.6,8H11.4A1.6,1.6 0 0,1 13,9.6V14.4A1.6,1.6 0 0,1 11.4,16H6.6A1.6,1.6 0 0,1 5,14.4V9.6A1.6,1.6 0 0,1 6.6,8Z
            M7,12A2,2 0 1,0 11,12A2,2 0 1,0 7,12Z" />
    <!-- Beam rays -->
    <path android:fillColor="#00000000" android:strokeColor="#FFFFFFFF" android:strokeWidth="1.6" android:strokeLineCap="round"
        android:pathData="M13.6,9.4L19,6.6" />
    <path android:fillColor="#00000000" android:strokeColor="#FFFFFFFF" android:strokeWidth="1.6" android:strokeLineCap="round"
        android:pathData="M14.2,12L20.4,12" />
    <path android:fillColor="#00000000" android:strokeColor="#FFFFFFFF" android:strokeWidth="1.6" android:strokeLineCap="round"
        android:pathData="M13.6,14.6L19,17.4" />
</vector>
